# Copy outside the checkout; fill every value before rendering.
# Paths must already exist on the NAS, not on the build computer.
# latest follows every release, 0.1 only fixes to 0.1, 0.1.0 never changes.
SLOPLEX_IMAGE=ghcr.io/mtdewwolf/sloplex:latest
SLOPLEX_UID=
SLOPLEX_GID=
SLOPLEX_PORT=
SLOPLEX_BIND_IP=
SLOPLEX_CONFIG=
SLOPLEX_STATE=
SLOPLEX_SCRATCH=
SLOPLEX_MEDIA=
# Only with compose.tailscale.yaml (remote access; see the deployment guide).
SLOPLEX_TS_STATE=
SLOPLEX_TS_HOSTNAME=sloplex
# A one-off Tailscale auth key, spent at first login; or leave empty.
SLOPLEX_TS_AUTHKEY=
